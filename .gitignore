# ---- Project-specific ----

# Run outputs (route logs, progress CSVs, video frames)
results/*
!results/.gitkeep
!results/README.md

# Data: everything under data/ is ignored by default, wherever it lives.
# Only the sample cities (Bath, Cambridge) and a few reference files are committed.
# See data/README.md. Check a path with: git check-ignore -v <path>
data/**
!data/**/
!data/**/*Bath*
!data/**/*Cambridge*
# Sample cities use the 5 km grid only; drop scale-10 instances and short paths
data/**/*_10_*
data/**/*_10.*
# Large or reproducible outputs stay local, even for sample cities
data/dem/**
data/processed/edge_samples/**
data/processed/plots/**
!data/**/
# Short paths are city-independent: one file per benchmark
!data/processed/short_paths/*.txt
!data/raw/solomon/*.csv
!data/raw/cities.csv
!data/**/.gitkeep
!data/**/README.md

